// Детальные связи автоматически поднимаются к родительским контейнерам/системам.
player -> mc.browser "Создаёт команды и сохраняет места" "HTTPS"
admin -> mc.browser "Редактирует библиотеки и запускает сценарии" "HTTPS"
player -> minecraft "Вставляет скопированную команду" "Minecraft client"
mc.browser -> mc.server "Загружает страницы и вызывает API" "HTTPS / JSON"
mc.browser.giveEditor -> mc.browser.giveEngine "Собирает команду"
mc.browser.summonEditor -> mc.browser.summonEngine "Собирает команду"
mc.browser.summonEditor -> mc.browser.preview "Передаёт состояние моба"
mc.browser.giveEditor -> mc.browser.localStorage "Сохраняет коллекцию"
mc.browser.summonEditor -> mc.browser.localStorage "Сохраняет коллекцию"
mc.browser.locations -> mc.browser.localStorage "Читает и сохраняет анонимные места"
mc.browser.assistant -> mc.browser.giveEditor "Применяет изменения полей"
mc.browser.assistant -> mc.browser.summonEditor "Применяет изменения полей"
mc.browser.assistant -> mc.server.ai "Передаёт prompt, snapshot и историю" "HTTPS / JSON"
mc.browser.locations -> mc.server.api "Синхронизирует и импортирует места" "HTTPS / JSON"
mc.browser.adminUi -> mc.browser.giveEditor "Переиспользует в adminMode"
mc.browser.adminUi -> mc.browser.summonEditor "Переиспользует в adminMode"
mc.browser.adminUi -> mc.server.api "Управляет библиотеками, публикациями и сценариями" "HTTPS / JSON"
mc.browser.adminUi -> mc.server.ai "Запрашивает AI-черновик сценария" "HTTPS / JSON"
mc.browser.adminUi -> mc.server.execution "Запускает сохранённый сценарий" "HTTPS / JSON"
mc.browser.giveEditor -> mc.browser.executor "Передаёт snapshot для admin"
mc.browser.summonEditor -> mc.browser.executor "Передаёт snapshot для admin"
mc.browser.executor -> mc.server.execution "Запрашивает выполнение команды" "HTTPS / JSON"
mc.server.pages -> mc.server.auth "Проверяет пользователя и роль"
mc.server.pages -> mc.server.repositories "Загружает данные для страниц"
mc.server.pages -> mc.server.exarotonClient "Загружает список серверов"
mc.server.api -> mc.server.auth "Проверяет пользователя и права защищённых запросов"
mc.server.api -> mc.server.repositories "Читает и изменяет данные"
mc.server.api -> mc.server.exarotonClient "Читает серверы и игроков"
mc.server.ai -> mc.server.auth "Определяет доступных провайдеров и admin-доступ"
mc.server.ai -> mc.server.repositories "Читает библиотеки для AI-сценария"
mc.server.ai -> mc.server.giveEngine "Нормализует snapshot предмета"
mc.server.ai -> mc.server.summonEngine "Нормализует snapshot моба"
mc.server.ai -> openai "Запрашивает AI-операции и черновики сценариев" "HTTPS / JSON"
mc.server.ai -> deepseek "Запрашивает AI-операции редакторов" "HTTPS / JSON"
mc.server.auth -> google "Проверяет личность через OAuth / OIDC" "HTTPS"
mc.server.repositories -> mc.server.db "Выполняет SQL-запросы"
mc.server.db -> mc.database "Читает и записывает" "SQL / HTTPS"
mc.server.execution -> mc.server.auth "Требует роль admin"
mc.server.execution -> mc.server.repositories "Загружает сценарии и библиотеки"
mc.server.execution -> mc.server.scenarios "Исполняет сценарий"
mc.server.execution -> mc.server.commands "Готовит одиночную команду"
mc.server.execution -> mc.server.exarotonClient "Проверяет сервер и выполняет одиночную команду"
mc.server.scenarios -> mc.server.commands "Собирает команды действий"
mc.server.scenarios -> mc.server.exarotonClient "Проверяет сервер и исполняет действия"
mc.server.commands -> mc.server.giveEngine "Собирает give / equip"
mc.server.commands -> mc.server.summonEngine "Собирает summon"
mc.server.exarotonClient -> exaroton "Получает серверы, игроков и отправляет команды" "HTTPS / JSON"
exaroton -> minecraft "Передаёт команду в консоль"
